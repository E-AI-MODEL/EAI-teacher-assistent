  "diagrams": [
    {
      "id": "d01",
      "file": "d01-kenniskaart.svg",
      "title": "Zes vondsten, drie ontwerpvragen",
      "subtitle": "Openbare bronronde 01: groepering op overeenkomstige onderzoeksvraag.",
      "description": "Zes openbare bronnen in drie paren, gekoppeld aan drie ontwerpvragen. Geen bewezen softwareafhankelijkheden."
    },
    {
      "id": "d02",
      "file": "d02-ontwerpgeschiedenis.svg",
      "title": "Ontwerpgeschiedenis in vijf momenten",
      "subtitle": "Kalenderdagen bepalen de afstand. Bronnen zijn niet automatisch elkaars opvolgers.",
      "description": "Vijf gedateerde momenten in 2026; de SSOT-migratiekaart beschrijft een versieontwikkeling. De andere gebeurtenissen zijn afzonderlijke bronnen."
    },
    {
      "id": "d03",
      "file": "d03-mechanismen.svg",
      "title": "Veertien mechanismen, vier onderzoeksgroepen",
      "subtitle": "Wat houden we gelijk? Wat veranderen we afzonderlijk in de vergelijking?",
      "description": "Veertien mechanismen: gedeelde functies, optimalisatie in B, extra hybride routes in C/D, inferentieplaats in D. Groepering is geen afhankelijkheidsgrafiek."
    },
    {
      "id": "d04",
      "file": "d04-varianten-abcd.svg",
      "title": "Wat verandert er tussen A, B, C en D?",
      "subtitle": "Eén gedeeld contract. Alleen benoemde verschillen veranderen per route.",
      "description": "A/B gebruiken dezelfde modeltaak; C/D kunnen een experimentele aanvraag zonder model uitvoeren; D gebruikt alleen lokale inferentie. Gewone functies zijn gedeeld."
    },
    {
      "id": "d05",
      "file": "d05-bewijsroute.svg",
      "title": "Van bronbevinding naar proef",
      "subtitle": "Vijf traceerbare koppelingen. De verificaties staan nog open in dit project.",
      "description": "Vijf rijen verbinden historische openbare bronnen aan technische eisen, ontwerpcontracten en geplande proeven. Geen uitgevoerde verificaties in dit project."
    },
    {
      "id": "d06",
      "file": "d06-eerdere-proeven.svg",
      "title": "Wat eerdere proeven werkelijk aantonen",
      "subtitle": "Twee experimentfamilies. De cijfers zijn niet onderling vergelijkbaar.",
      "description": "EAT Inline: 77,42% naamzoeken versus 98,85% EAT na unieke naamkoppeling; 100% is een controle met correct ID uit testantwoorden. NeSy P02: nul van tien doelroutes; P03: acht van acht herbeoordelingen en nul onafhankelijke menselijke beoordelingen."
    },
    {
      "id": "d07",
      "file": "d07-orchestrator.svg",
      "title": "Orchestrator: eerst een toegestane route",
      "subtitle": "C/D: beslis alleen met actuele gegevens. Onbekend is geen toestemming.",
      "description": "Hybride route: gewone functie eerst; experimentele regel MATCH naar engine, UNKNOWN alleen naar toegestane modeltaak, DENY afwijzen. Iedere af te leveren uitkomst vereist actuele rechten en revisie."
    }
  ],
